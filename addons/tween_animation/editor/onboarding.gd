@tool
extends RefCounted
## Small, complete scripts paired with one action per onboarding card.

static func lessons(mode: int) -> Array[Dictionary]:
	var path: String = ["$Sprite2D", "$MeshInstance3D", "$Panel"][mode]
	var distance := "2.0" if mode == 1 else "100.0"
	var vector := "Vector3.LEFT" if mode == 1 else "Vector2.LEFT"
	var prefix := "extends Node\n\n@onready var target = " + path + "\n"
	var setup := prefix + "var animate := Tweenimator.new()\n"
	var native_move := '    var tween := create_tween()\n    tween.tween_property(target, "position", target.position + %s * %s, 0.4)\n' % [vector, distance]
	var helper_move := "animate.move_left(target, " + distance + ", 0.4)"
	var output: Array[Dictionary] = []
	output.append({"title": "Your animation toolbox", "action": "Create one Tweenimator. No Tween needed yet.", "body": "Put [code]var animate := Tweenimator.new()[/code] in a script on the target's parent. This instance will remember your named animations.\n\n[b]Choose the owner later:[/b] new() lets a Node-target effect use its target. new(self) chooses this controller as the default owner instead.", "visual": "TOOLBOX  →  READY", "native": prefix + "\nfunc _ready() -> void:\n    # Godot can create Tweens directly without any helper.\n    pass\n", "helper": setup + "\nfunc _ready() -> void:\n    # Nothing starts just by creating the manager.\n    pass\n\n# Alternative: use Tweenimator.new(self) for a shared controller owner.\n"})
	output.append({"title": "Make your first move", "action": "Call a named effect. It creates its own Tween.", "body": "Run this scene. Your target slides left. There is no outside Tween to prepare or pass in.\n\n[b]Try it:[/b] swap move_left for move_right. In 3D, distance uses scene units; 2D/UI normally use pixels. These directions follow the parent's axes.", "visual": "EFFECT  →  NEW TWEEN", "native": prefix + "\nfunc _ready() -> void:\n" + native_move, "helper": setup + "\nfunc _ready() -> void:\n    " + helper_move + "\n"})
	output.append({"title": "Keep the Tween you just made", "action": "Save the return value, then give it a name.", "body": "The final 0.2 is interval: move for 0.4 seconds, then wait 0.2 seconds on the same returned Tween. Omit it or use 0.0 for no wait. Native Godot uses tween_interval(0.2) for the same result. await slide.finished waits for both stages.\n\n[b]Name it too:[/b] store(&\"slide\", slide) puts that same object in the dictionary. Storing does not create a second Tween or restart the first.", "visual": "RETURN VALUE  →  slide  →  DICTIONARY", "native": prefix + "\nvar slide: Tween\n\nfunc _ready() -> void:\n    slide = create_tween()\n    slide.tween_property(target, \"position\", target.position + " + vector + " * " + distance + ", 0.4)\n    slide.tween_interval(0.2)\n    await slide.finished\n    print(\"Slide complete\")\n", "helper": setup + "\nvar slide: Tween\n\nfunc _ready() -> void:\n    slide = " + helper_move.trim_suffix(")") + ", 0.2)" + "\n    animate.store(&\"slide\", slide)\n    await slide.finished\n    print(\"Slide complete\")\n"})
	output.append({"title": "Build a named animation", "action": "Create intro inside a function you can call again.", "body": "create(&\"intro\", self) creates and stores a Tween in one call. Append any ordinary Godot Tween operations to it.\n\n[b]Replay recipe:[/b] call play_intro() again. It builds a fresh Tween; completed Tweens cannot be replayed. A name collision replaces the old animation.", "visual": "play_intro()  →  intro  →  PLAY", "native": prefix + "\nvar intro: Tween\n\nfunc _ready() -> void:\n    play_intro()\n\nfunc play_intro() -> void:\n    if intro and intro.is_valid():\n        intro.kill()\n    intro = create_tween()\n    intro.tween_property(target, \"position\", target.position + " + vector + " * " + distance + ", 0.4)\n", "helper": setup + "\nfunc _ready() -> void:\n    play_intro()\n\nfunc play_intro() -> void:\n    # This Tween is stored as intro before you add its animation steps.\n    var intro := animate.create(&\"intro\", self)\n    intro.tween_property(target, \"position\", target.position + " + vector + " * " + distance + ", 0.4)\n"})
	output.append({"title": "Bring a Tween from anywhere", "action": "Store an existing Tween under your own name.", "body": "Other scripts may create Tweens before this Tweenimator exists. Pass any valid Tween to store() when you want to track it.\n\n[b]Same object, same animation:[/b] storing keeps its owner, easing and existing operations unchanged. Share your Tweenimator instance with scripts that need its dictionary.", "visual": "EXTERNAL TWEEN  →  store()  →  external", "native": prefix + "\nvar external: Tween\n\nfunc _ready() -> void:\n    external = create_tween()\n    external.tween_property(target, \"position:x\", 40.0, 1.0)\n    external.pause()\n    external.play()\n", "helper": prefix + "\nfunc _ready() -> void:\n    # This Tween even predates its manager.\n    var external := create_tween()\n    external.tween_property(target, \"position:x\", 40.0, 1.0)\n    var animate := Tweenimator.new()\n    animate.store(&\"external\", external)\n    animate.pause(&\"external\")\n    animate.resume(&\"external\")\n"})
	output.append({"title": "Find it by name", "action": "Use the dictionary or a safe lookup.", "body": "tweens[&\"slide\"] gives you the actual Tween. Use get_tween() when you are unsure the name exists.\n\n[b]You are in control:[/b] pause/resume changes an active animation; stop_named kills it. Finished names disappear automatically. To run it again, call the function that builds it, such as play_intro().", "visual": "NAME  →  HANDLE  →  PAUSE / RESUME", "native": prefix + "\nvar tweens: Dictionary[StringName, Tween] = {}\n\nfunc _ready() -> void:\n    var slide := create_tween()\n    slide.tween_property(target, \"position:x\", 40.0, 1.0)\n    tweens[&\"slide\"] = slide\n    var found: Tween = tweens.get(&\"slide\")\n    if found and found.is_valid():\n        found.pause()\n        found.play()\n    # Plain dictionaries need your own cleanup and replacement logic.\n", "helper": setup + "\nfunc _ready() -> void:\n    animate.store(&\"slide\", " + helper_move + ")\n    # Direct dictionary access: only use a known live name.\n    var same_tween: Tween = animate.tweens[&\"slide\"]\n    same_tween.pause()\n    # Safe lookup: absent or finished names return null.\n    var found := animate.get_tween(&\"slide\")\n    if found:\n        animate.resume(&\"slide\")\n\nfunc stop_slide() -> void:\n    animate.stop_named(&\"slide\")\n"})
	output.append({"title": "Hand it back to your own code", "action": "Release tracking without stopping the animation.", "body": "release(&\"slide\") returns the Tween and removes its name and helper replacement tracking. The animation can keep running outside Tweenimator.\n\n[b]Pick the behavior you need:[/b] release keeps playing; stop_named kills one; clear(false) releases all names. Ordinary Tween methods still work on every returned handle.", "visual": "DICTIONARY  →  release()  →  YOUR CODE", "native": prefix + "\nvar slide: Tween\n\nfunc _ready() -> void:\n    slide = create_tween()\n    slide.tween_property(target, \"position:x\", 40.0, 1.0)\n    use_elsewhere(slide)\n\nfunc use_elsewhere(tween: Tween) -> void:\n    tween.tween_interval(0.2)\n", "helper": setup + "\nfunc _ready() -> void:\n    animate.store(&\"slide\", " + helper_move + ")\n    var handed_back := animate.release(&\"slide\")\n    use_elsewhere(handed_back)\n\nfunc use_elsewhere(tween: Tween) -> void:\n    tween.tween_interval(0.2)\n"})
	return output
