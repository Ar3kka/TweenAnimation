@tool
extends RefCounted

static func lessons(mode: int) -> Array[Dictionary]:
	var target: String = ["Node2D", "Node3D", "Control"][mode]
	var sample: String = ["Sprite2D", "MeshInstance3D", "Panel"][mode]
	var property := "modulate:a" if mode == 2 else "position"
	var change := "set modulate → alpha to a different value" if mode == 2 else "move the selected node to a new position"
	var steps: Array[Dictionary] = [
		{"title": "The selected node is your animation target", "action": "Select the tutorial's " + sample + " below to choose what to animate.", "body": "[b]Why select a node?[/b] When you press [b]Add track[/b], the timeline uses the currently selected node as that track's target. Selecting a " + target + " tells it whose position, scale or other property you want to animate.\n\n[b]In this tutorial:[/b] the tree below contains a sample " + sample + ". Select it to practice choosing an animation target. Selection has a real purpose in the workflow; it is not a requirement for unlocking the next lesson.\n\n[b]In your project:[/b] select your own node in [b]Godot's Scene tree[/b], then open Tweenimation's [b]Timeline[/b] and add a property track. Existing tracks keep their original targets when your selection changes.", "visual": "SELECTED NODE  →  NEW TRACK TARGET"},
		{"title": "Give it a timeline lane", "action": "Add a " + property + " track for the selected " + sample + ".", "body": "[b]Try here:[/b] the tutorial node is selected for this example. Enter [b]" + property + "[/b] in the Property field and choose [b]Add track[/b]. The new track names both the node and the property it will animate.\n\n[b]In your project:[/b] Add track uses the node selected in Godot's Scene tree. Each track stores that node's path, so you can add tracks for different nodes to the same animation.", "visual": "SELECT NODE  →  ADD TRACK"},
		{"title": "Save the opening pose", "action": "Read the current value, then press Capture key at 0.00 s.", "body": "[b]Try here:[/b] the colored [b]X/Y/Z[/b] values (or scalar value) show the live sample. [b]Current[/b] captures that value. Choose [b]Override[/b] to type a different value, or open [b]Examples[/b] for the accepted format and ready-to-use values. Switch back to Current to discard the override.\n\n[b]In your project:[/b] Current node value reads the node bound to the active track. The key badge shows whether a value is saved at the playhead; hover it to inspect that saved value. It can differ from a fresh Inspector edit.", "visual": "READ VALUE  →  CAPTURE"},
		{"title": "Choose where it ends", "action": "Follow the outline: time → sample Inspector → Capture key.", "body": "[b]Try here:[/b] the opening key is already provided. Drag the time slider to [b]1.00 s[/b], then set [b]" + ("Alpha to 1" if mode == 2 else ("X to 2" if mode == 1 else "X to 100")) + "[/b] in the sample Inspector and capture the destination. The outline moves to the control needed next.\n\n[b]In your project:[/b] move the playhead, " + change + " in Godot's Inspector or viewport, then capture the key. Two poses let the timeline calculate the values between them.", "visual": "TIME  →  VALUE  →  CAPTURE"},
		{"title": "Watch it move", "action": "Press the outlined Play preview button.", "body": "[b]Try here:[/b] this lesson provides both keys so you can preview the complete sample. The picture follows the playhead. Try [b]After-effect interval = 0.5 s[/b]: the 1-second movement finishes, holds its final pose for 0.5 seconds, then the preview loops. Zero adds no wait. Rewind returns to its beginning.\n\n[b]In your project:[/b] action templates also offer an optional interval, represented by a final hold key. In code, pass interval as the helper's last argument; native Godot uses tween_interval(). Playback updates the open scene. Switch to Godot's " + ("3D" if mode == 1 else "2D") + " editor to see it and return here to pause. Preview leaves sampled values on the nodes.", "visual": "KEYS  →  PLAYBACK"},
		{"title": "Keep your clip", "action": "Try the outlined Save button, then open the real Timeline when ready.", "body": "[b]Try here:[/b] Save explains the result without writing a file. Each tutorial page uses a prepared example; your project animation is separate.\n\n[b]In your project:[/b] Timeline → Save creates an [b]Animation .tres[/b] resource. Play it through an AnimationPlayer library, or use Autoplay on Load. Open timeline above takes you to the editor for your own scene.", "visual": "SAVE  →  REUSE"}
	]
	return steps
